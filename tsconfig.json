{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    // The checking config covers src *and* test: `tsc -p tsconfig.build.json`
    // narrows back to src for emit. Tests import source through explicit `.ts`
    // specifiers, which only resolve under noEmit.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "scripts"]
}
