{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    // Everything imports through explicit `.ts` specifiers, so Node runs src,
    // tests and scripts directly with type stripping - no loader. Emit rewrites
    // those specifiers to `.js`, and erasableSyntaxOnly rejects the syntax
    // (enums, namespaces, parameter properties) stripping cannot run.
    // The checking config covers src *and* test; `tsc -p tsconfig.build.json`
    // narrows back to src for emit.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "scripts"]
}
