{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "quoteProps": "as-needed",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "embeddedLanguageFormatting": "off", // no embedded languages in this library
  "proseWrap": "preserve",

  // JSX options omitted - src/react.ts uses createElement, not JSX

  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "pnpm-lock.yaml",
    "package-lock.json",
    // Generated by `pnpm run api:surface` on every build. Formatting it would be
    // undone by the next build, so the generator owns its layout.
    "api-surface.json",
  ],

  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown",
      // no "style" group - energy.css is shipped, never imported by source
    ],
    "internalPattern": ["~/", "@/", "#"],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true,
    "sortSideEffects": false,
  },

  "sortPackageJson": true,

  "overrides": [
    {
      // Markdown docs - don't reformat prose
      "files": ["**/*.md"],
      "options": {
        "proseWrap": "preserve",
        "printWidth": 120,
      },
    },
  ],
}
