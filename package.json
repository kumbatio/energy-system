{
  "name": "@kumbatio/energy-system",
  "version": "2.2.1",
  "private": false,
  "description": "Framework-agnostic TypeScript library for energy-aware application behavior.",
  "keywords": [
    "accessibility",
    "adaptive-ui",
    "adhd",
    "capacity",
    "cognitive-load",
    "energy",
    "focus",
    "neurodivergent",
    "notifications",
    "react",
    "state",
    "typescript"
  ],
  "homepage": "https://docs.kumbat.io/docs/energy-system",
  "bugs": {
    "url": "https://github.com/kumbatio/energy-system/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumbatio/energy-system.git"
  },
  "files": [
    "dist",
    "src/energy.css",
    "api-surface.json",
    "conformance.json",
    "spec",
    "SPEC.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/energy.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./css": "./src/energy.css",
    "./api-surface.json": "./api-surface.json",
    "./package.json": "./package.json",
    "./conformance.json": "./conformance.json",
    "./spec/energy-state.schema.json": "./spec/energy-state.schema.json",
    "./spec/conformance.schema.json": "./spec/conformance.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:ts && pnpm run api:surface && pnpm run conformance",
    "api:surface": "node scripts/extract-api-surface.ts",
    "api:surface:check": "node scripts/extract-api-surface.ts --check",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build:ts && node --test 'test/**/*.test.ts'",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run check-types && pnpm run test && pnpm run pack:dry-run",
    "prepack": "pnpm run format:check && pnpm run lint && pnpm run check-types && pnpm run test",
    "pack:dry-run": "pnpm pack --dry-run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --type-aware --type-check --fix . && oxfmt --write .",
    "lint:fix-unsafe": "oxlint --type-aware --type-check --fix --fix-suggestions --fix-dangerously . && oxfmt --write .",
    "check:fix-suggestions": "oxlint --type-aware --type-check --fix --fix-suggestions . && oxfmt --write .",
    "conformance": "TZ=UTC node scripts/extract-conformance.ts",
    "conformance:check": "TZ=UTC node scripts/extract-conformance.ts --check",
    "release": "release-kit"
  },
  "devDependencies": {
    "@entro314labs/release-kit": "^2.11.0",
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.20.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "next"
  },
  "peerDependencies": {
    "@types/react": ">=19.2.0",
    "react": ">=19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6"
}
